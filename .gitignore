# Rust build outputs (large ~1.4 GB generated binaries/intermediates)
/target/
**/*.rs.bk
*.pdb

# Release binary executables & temporary unpackaged copies (only track the 3 distributable deliverables below)
/release/*.exe
/release/*.dll
/release/*.ico
/release/*.zip
/release/PDFForge-1.1.3-Windows-x64-Portable/
/release/PDFForge-1.2.5-Windows-x64-Portable/
/release/PDFForge-1.3.0-Windows-x64-Portable/
/release/PDFForge-1.3.1-Windows-x64-Portable/
/release/tesseract/
/release/tessdata/
/release/macos/*.app/Contents/MacOS/PDFForge-bin
!/release/PDFForge-Setup-1.3.1-Windows-x64.exe
!/release/PDFForge-1.3.1-Windows-x64-Portable.zip
!/release/PDFForge-1.3.1-macOS-Installer.zip
!/release/PDFForge-1.3.1-macOS-Universal.dmg

# OS, Editor & Temporary files
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
