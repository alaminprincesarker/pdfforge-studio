1 ICON "src-rust/icon.ico"
2 ICON "src-rust/pdf_doc.ico"
1 24 "src-rust/app.manifest"

1 VERSIONINFO
FILEVERSION 1,1,2,0
PRODUCTVERSION 1,1,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Md. Alamin (PDFForge Studio)"
            VALUE "FileDescription", "PDFForge - Native Rust Desktop PDF Reader & Editor"
            VALUE "FileVersion", "1.1.2.0"
            VALUE "InternalName", "PDFForge"
            VALUE "LegalCopyright", "Copyright (C) 2026 Md. Alamin (alaminprincesarker@gmail.com)"
            VALUE "OriginalFilename", "PDFForge.exe"
            VALUE "ProductName", "PDFForge Studio"
            VALUE "ProductVersion", "1.1.2"
            VALUE "Comments", "100% Offline Native Rust Desktop PDF Reader & Editor"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

